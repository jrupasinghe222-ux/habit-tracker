{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "backend.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Backend: test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Frontend: run",
      "type": "shell",
      "command": "npm.cmd run dev",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    }
  ]
}
